{
  "name": "nuvio",
  "private": true,
  "version": "0.6.2",
  "description": "Nuvio — a lightweight, DIY animated wallpaper layer for Codex Desktop, with Wallpaper Engine workshop detection.",
  "license": "MIT",
  "author": "QuisVic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QYH1219/Nuvio.git"
  },
  "homepage": "https://qyh1219.github.io/Nuvio/",
  "bugs": {
    "url": "https://github.com/QYH1219/Nuvio/issues"
  },
  "keywords": [
    "codex",
    "webgl",
    "three.js",
    "dynamic-background",
    "glb",
    "tripo",
    "electron",
    "cdp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "vite --host 127.0.0.1 --port 5273",
    "predev": "node tools/sync-decoders.mjs",
    "build": "vite build",
    "prebuild": "node tools/sync-decoders.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5274",
    "preembed": "node tools/sync-decoders.mjs",
    "embed": "vite build --mode embed",
    "build:all": "npm run embed && npm run build",
    "inject": "node tools/inject.mjs",
    "doctor": "node tools/doctor.mjs",
    "restore": "node tools/restore.mjs",
    "bundle": "node tools/bundle.mjs",
    "pack": "node tools/pack.mjs",
    "sign": "node tools/sign.mjs",
    "size": "node tools/size.mjs",
    "shortcut": "node tools/shortcut.mjs",
    "autostart": "node tools/autostart.mjs",
    "restart": "node tools/restart.mjs",
    "test": "node --test",
    "launch:codex": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-codex.ps1",
    "sync:decoders": "node tools/sync-decoders.mjs",
    "wallpaper": "node tools/wallpaper.mjs",
    "use": "node tools/use.mjs",
    "library": "node tools/library.mjs",
    "workshop": "node tools/workshop-scan.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^6.4.5"
  }
}
